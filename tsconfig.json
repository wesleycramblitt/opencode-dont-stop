{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid"
  },
  "include": ["index.ts", "lib/**/*.ts", "scripts/**/*.ts"],
  // tui.tsx is excluded: it imports @opencode/plugin/tui and @opentui/solid,
  // which the opencode server provides at runtime but which are not
  // installable standalone. The voice plugin takes the same approach.
  "exclude": ["node_modules", "tui.tsx"]
}